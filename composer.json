    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "fakerphp/faker": "1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "gating/gate": "*@dev",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/var-dumper": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": [
                "src/",
                "../Currencing/src/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "gating:check": [
            "php bin/console gating:check --target=.",
            "@inspect:rolling-host"
        ],
        "autoload:refresh": "composer dump-autoload --no-scripts",
        "vendor:fixtures:load": "php bin/console app:vendor:fixtures:load",
        "memory:scope:resolve": "php tools/code-memory/scope-resolve.php --cwd=. --json",
        "memory:scope:cache": "php tools/code-memory/scope-resolve.php --cwd=. --json --write-cache",
        "ai-review:validate": "php tools/gating/validate-ai-review.php",
        "inspect:navigation-ea-route": "php tools/inspection/app-navigation-ea-route-guard.php",
        "inspect:runtime-lock-authority": "php tools/inspection/app-runtime-lock-authority-guard.php",
        "inspect:rolling-host": "php tools/inspection/app-rolling-host-guard.php",
        "test:preprod:postgres": "powershell -ExecutionPolicy Bypass -File tools/preprod-postgres.ps1",
        "test:preprod:postgres:docker": "powershell -ExecutionPolicy Bypass -File tools/preprod-postgres.ps1 -UseDocker",
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.0"
        }
    }
}
